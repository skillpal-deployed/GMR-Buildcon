{
  "name": "gmr-buildcon",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "GMR Buildcon — Next.js + Express + PostgreSQL port of the WordPress theme",
  "scripts": {
    "dev": "concurrently -n next,api -c cyan,magenta \"next dev\" \"npm run dev:api\"",
    "dev:web": "next dev",
    "dev:api": "tsx watch server/standalone.ts",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "start:api": "tsx server/standalone.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "import:wxr": "tsx scripts/import-wxr.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "next": "^15.1.6",
    "nodemailer": "^6.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "serverless-http": "^3.2.0",
    "slugify": "^1.6.6",
    "xml2js": "^0.6.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/xml2js": "^0.4.14",
    "concurrently": "^9.1.2",
    "prisma": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
