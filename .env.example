# ---------------------------------------------------------------------------
# GMR Buildcon — environment variables
# Copy to ".env" and fill in. Never commit ".env".
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) -------------------------------------------------
# Runtime queries use DATABASE_URL; Prisma migrations / db push use DIRECT_URL.
#
# Supabase (production): Project Settings -> Database -> Connection string
#   DATABASE_URL = the "Transaction pooler" string (port 6543), add ?pgbouncer=true
#   DIRECT_URL   = the "Direct connection"/"Session" string (port 5432)
#
# Local single Postgres (no pooler): set BOTH to the same URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Auth (admin dashboard) ------------------------------------------------
# A long random string. Generate one with:  openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-secret"

# Default admin account, created by `npm run db:seed`
ADMIN_EMAIL="admin@gmrbuildcon.com"
ADMIN_PASSWORD="change-this-to-a-strong-password"
ADMIN_NAME="GMR Admin"

# --- Contact form email (optional) -----------------------------------------
# If SMTP is left blank, submissions are still saved to the database and
# viewable in the admin dashboard; only the email notification is skipped.
CONTACT_TO="info@gmrbuildcon.com"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="GMR Buildcon <no-reply@gmrbuildcon.com>"

# --- Server ----------------------------------------------------------------
# Port for the standalone Express API (local dev + non-Vercel hosts)
API_PORT="4000"
# Dev only: where Next proxies /api/* to. Defaults to http://localhost:4000
# API_PROXY="http://localhost:4000"

# --- Public site -----------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Image uploads (admin) -------------------------------------------------
# Local/standalone hosts write uploads to /public/uploads (default).
# On Vercel (read-only FS) set a Vercel Blob token to store uploads in the cloud:
# BLOB_READ_WRITE_TOKEN=""
